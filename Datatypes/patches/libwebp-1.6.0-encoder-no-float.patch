+// AmigaOS 3.x datatypes: no floating point, so the encoder runs without an
+// FPU and without the ROM math libraries. The quality, a float from 0 to
+// 100, truncated to an integer from its IEEE single-precision bits.
+static int QualityInt(float quality) {
+  union { float f; uint32_t u; } v;
+  int exponent;
+  uint32_t mantissa;
+  v.f = quality;
+  exponent = (int)((v.u >> 23) & 0xff) - 127;
+  if ((v.u >> 31) || exponent < 0) return 0;      // negative, or below 1
+  if (exponent > 23) return 100;                  // far above 100
+  mantissa = (v.u & 0x7fffff) | 0x800000;
+  return (int)(mantissa >> (23 - exponent));
+}
